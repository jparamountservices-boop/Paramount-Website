---
/**
 * "Follow us on Instagram" section.
 *  - If company.instagramWidget is set, renders that live-feed embed.
 *  - Otherwise renders a grid of tiles linking to the Instagram profile.
 *    Drop optimized square images into public/images/instagram/ named
 *    ig-1.jpg … ig-6.jpg to replace the placeholders.
 * See docs/deployment/instagram-feed.md.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { company } from '../data/company';

const ig = company.social.instagram;
const handle = company.instagramHandle;

// Pull real project photos (same source as the Our Work gallery). Pick one per
// category first for variety, then fill up to 6.
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projects/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const byFolder: Record<string, ImageMetadata[]> = {};
for (const [path, mod] of Object.entries(modules)) {
  const folder = path.split('/').slice(-2)[0];
  (byFolder[folder] ??= []).push(mod.default);
}
const folders = Object.keys(byFolder);
const picked: ImageMetadata[] = [];
let i = 0;
while (picked.length < 6 && folders.some((f) => byFolder[f].length)) {
  const f = folders[i % folders.length];
  const next = byFolder[f].shift();
  if (next) picked.push(next);
  i++;
}
const featured = await Promise.all(
  picked.map((meta) => getImage({ src: meta, width: 600, height: 600, fit: 'cover', format: 'webp', quality: 78 }))
);
---

<section class="border-t border-[var(--color-steel)] bg-[var(--color-graphite)]">
  <div class="wrap py-16">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="eyebrow">Follow along</p>
        <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">See our latest projects</h2>
        <p class="mt-3 text-[var(--color-concrete)]">Fresh builds, before-and-afters and behind-the-scenes on Instagram &amp; Facebook.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={ig} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 4.9a4.9 4.9 0 1 0 0 9.8 4.9 4.9 0 0 0 0-9.8Zm0 8.1a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Zm6.2-8.3a1.1 1.1 0 1 1-2.3 0 1.1 1.1 0 0 1 2.3 0Z"/></svg>
          Instagram
        </a>
        <a href={company.social.facebook} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z"/></svg>
          See our work on Facebook
        </a>
      </div>
    </div>

    {company.instagramWidget ? (
      <div class="mt-10" set:html={company.instagramWidget} />
    ) : featured.length > 0 ? (
      <div class="mt-10 grid grid-cols-3 gap-3 sm:grid-cols-6">
        {featured.map((img) => (
          <a
            href="/our-work/"
            class="group relative flex aspect-square items-center justify-center overflow-hidden rounded-lg border border-[var(--color-steel)] bg-[var(--color-graphite-2)]"
            aria-label="See more of our work"
          >
            <img
              src={img.src}
              alt="Recent concrete & hardscape project by Paramount, Knoxville TN"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-105"
            />
          </a>
        ))}
      </div>
    ) : null}
  </div>
</section>
