---
/**
 * "Follow us on Instagram" section.
 *  - If company.instagramWidget is set, renders that live-feed embed.
 *  - Otherwise renders a grid of tiles linking to the Instagram profile.
 *    Drop optimized square images into public/images/instagram/ named
 *    ig-1.jpg … ig-6.jpg to replace the placeholders.
 * See docs/deployment/instagram-feed.md.
 */
import { company } from '../data/company';

const ig = company.social.instagram;
const handle = company.instagramHandle;
const tiles = [1, 2, 3, 4, 5, 6];
---

<section class="border-t border-[var(--color-steel)] bg-[var(--color-graphite)]">
  <div class="wrap py-16">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="eyebrow">Follow along</p>
        <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">See our latest projects</h2>
        <p class="mt-3 text-[var(--color-concrete)]">Fresh builds, before-and-afters and behind-the-scenes on Instagram.</p>
      </div>
      <a href={ig} target="_blank" rel="noopener noreferrer" class="btn btn-primary">@{handle}</a>
    </div>

    {company.instagramWidget ? (
      <div class="mt-10" set:html={company.instagramWidget} />
    ) : (
      <div class="mt-10 grid grid-cols-3 gap-3 sm:grid-cols-6">
        {tiles.map((n) => (
          <a
            href={ig}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative flex aspect-square items-center justify-center overflow-hidden rounded-lg border border-[var(--color-steel)] bg-[var(--color-graphite-2)]"
            aria-label={`View @${handle} on Instagram`}
          >
            <img
              src={`/images/instagram/ig-${n}.jpg`}
              alt=""
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
              class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-105"
            />
            <svg viewBox="0 0 24 24" class="relative h-6 w-6 text-[var(--color-concrete-dim)] transition group-hover:text-[var(--color-flame)]" fill="currentColor">
              <path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 4.9a4.9 4.9 0 1 0 0 9.8 4.9 4.9 0 0 0 0-9.8Zm0 8.1a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Zm6.2-8.3a1.1 1.1 0 1 1-2.3 0 1.1 1.1 0 0 1 2.3 0Z" />
            </svg>
          </a>
        ))}
      </div>
    )}
  </div>
</section>
