---
import { company } from '../data/company';
import { servicesByGroup } from '../data/services';
import { serviceAreas } from '../data/serviceAreas';
import Logo from './Logo.astro';

const groups = servicesByGroup();
const groupOrder = ['Concrete', 'Pavers', 'Hardscapes'] as const;
---

<header class="sticky top-0 z-50 border-b border-[var(--color-steel)] bg-[color-mix(in_srgb,var(--color-ink)_92%,transparent)] backdrop-blur">
  <div class="wrap flex items-center justify-between gap-4 py-3">
    <Logo />

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
      <div class="group relative">
        <button class="py-2 text-sm font-semibold text-[var(--color-concrete)] transition hover:text-[var(--color-bone)]">
          Services ▾
        </button>
        <div class="invisible absolute left-1/2 top-full -translate-x-1/2 pt-2 opacity-0 transition group-hover:visible group-hover:opacity-100">
          <div class="grid w-[36rem] grid-cols-2 gap-x-6 gap-y-1 rounded-lg border border-[var(--color-steel)] bg-[var(--color-graphite)] p-5 shadow-2xl">
            {
              groupOrder.map((g) => (
                <div>
                  <p class="mb-1 text-xs font-bold uppercase tracking-wider text-[var(--color-flame)]">{g}</p>
                  <ul class="mb-3 space-y-1">
                    {groups[g]?.map((s) => (
                      <li>
                        <a href={`/${s.path}/`} class="block rounded px-2 py-1 text-sm text-[var(--color-concrete)] transition hover:bg-[var(--color-graphite-2)] hover:text-[var(--color-bone)]">
                          {s.navLabel}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="group relative">
        <button class="py-2 text-sm font-semibold text-[var(--color-concrete)] transition hover:text-[var(--color-bone)]">
          Service Areas ▾
        </button>
        <div class="invisible absolute left-1/2 top-full -translate-x-1/2 pt-2 opacity-0 transition group-hover:visible group-hover:opacity-100">
          <div class="w-56 rounded-lg border border-[var(--color-steel)] bg-[var(--color-graphite)] p-3 shadow-2xl">
            <ul class="space-y-1">
              <li><a href="/service-area/" class="block rounded px-2 py-1 text-sm font-semibold text-[var(--color-bone)] hover:bg-[var(--color-graphite-2)]">All Service Areas</a></li>
              {serviceAreas.map((a) => (
                <li><a href={`/service-area/${a.slug}/`} class="block rounded px-2 py-1 text-sm text-[var(--color-concrete)] transition hover:bg-[var(--color-graphite-2)] hover:text-[var(--color-bone)]">{a.city}</a></li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <a href="/our-work/" class="text-sm font-semibold text-[var(--color-concrete)] transition hover:text-[var(--color-bone)]">Our Work</a>
      <a href="/cost-estimator/" class="text-sm font-semibold text-[var(--color-concrete)] transition hover:text-[var(--color-bone)]">Cost Estimator</a>
      <a href="/blog/" class="text-sm font-semibold text-[var(--color-concrete)] transition hover:text-[var(--color-bone)]">Blog</a>
      <a href="/about/" class="text-sm font-semibold text-[var(--color-concrete)] transition hover:text-[var(--color-bone)]">About</a>
    </nav>

    <div class="flex items-center gap-3">
      <a href={company.phoneHref} class="hidden text-sm font-bold text-[var(--color-bone)] sm:block">
        {company.phone}
      </a>
      <a href="/contact/" class="btn btn-primary text-sm">Free Phone Consultation</a>
      <!-- Mobile menu toggle -->
      <button id="menu-toggle" class="lg:hidden grid h-10 w-10 place-items-center rounded border border-[var(--color-steel)]" aria-label="Open menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav panel: absolute overlay, scrollable, with tap-to-expand submenus -->
  <div
    id="mobile-nav"
    class="hidden absolute inset-x-0 top-full max-h-[calc(100vh-4rem)] overflow-y-auto border-t border-[var(--color-steel)] bg-[var(--color-graphite)] shadow-2xl lg:hidden"
  >
    <nav class="wrap flex flex-col py-1 text-base" aria-label="Mobile">
      <!-- Services (expandable) -->
      <details class="group border-b border-[var(--color-steel)]">
        <summary class="flex cursor-pointer list-none items-center justify-between py-3.5 font-semibold text-[var(--color-bone)]">
          Services
          <span class="text-lg text-[var(--color-flame)] transition group-open:rotate-45">＋</span>
        </summary>
        <div class="pb-3">
          {groupOrder.map((g) => (
            <div class="mb-2">
              <p class="mb-1 text-xs font-bold uppercase tracking-wider text-[var(--color-flame)]">{g}</p>
              {groups[g]?.map((s) => (
                <a href={`/${s.path}/`} class="block py-2 pl-3 text-[var(--color-concrete)]">{s.navLabel.replace(' (overview)', '')}</a>
              ))}
            </div>
          ))}
          <a href="/services/" class="block py-2 pl-3 font-semibold text-[var(--color-flame-300)]">All services →</a>
        </div>
      </details>

      <!-- Service Areas (expandable) -->
      <details class="group border-b border-[var(--color-steel)]">
        <summary class="flex cursor-pointer list-none items-center justify-between py-3.5 font-semibold text-[var(--color-bone)]">
          Service Areas
          <span class="text-lg text-[var(--color-flame)] transition group-open:rotate-45">＋</span>
        </summary>
        <div class="pb-3">
          <a href="/service-area/" class="block py-2 pl-3 font-semibold text-[var(--color-flame-300)]">All Service Areas →</a>
          {serviceAreas.map((a) => (
            <a href={`/service-area/${a.slug}/`} class="block py-2 pl-3 text-[var(--color-concrete)]">{a.city}, TN</a>
          ))}
        </div>
      </details>

      <a href="/our-work/" class="border-b border-[var(--color-steel)] py-3.5 font-semibold text-[var(--color-bone)]">Our Work</a>
      <a href="/cost-estimator/" class="border-b border-[var(--color-steel)] py-3.5 font-semibold text-[var(--color-bone)]">Cost Estimator</a>
      <a href="/blog/" class="border-b border-[var(--color-steel)] py-3.5 font-semibold text-[var(--color-bone)]">Blog</a>
      <a href="/about/" class="border-b border-[var(--color-steel)] py-3.5 font-semibold text-[var(--color-bone)]">About</a>

      <div class="flex flex-col gap-3 py-4">
        <a href="/contact/" class="btn btn-primary w-full">Free Phone Consultation</a>
        <a href={company.phoneHref} class="btn btn-ghost w-full">Call {company.phone}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const panel = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = panel?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(open === false));
  });
</script>
