---
import { company } from '../data/company';

interface Props {
  heading?: string;
  sub?: string;
}
const {
  heading = 'Ready to build something that lasts?',
  sub = 'Get a free, no-pressure estimate from Knoxville’s concrete & hardscape team.',
} = Astro.props;
---

<section class="relative overflow-hidden bg-[var(--color-flame)]">
  <div class="wrap flex flex-col items-center gap-6 py-14 text-center md:flex-row md:justify-between md:text-left">
    <div>
      <h2 class="text-2xl font-extrabold text-white sm:text-3xl">{heading}</h2>
      <p class="mt-2 max-w-xl text-white/90">{sub}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href="/contact/" class="btn bg-[var(--color-bone)] text-white hover:bg-black">Get a Free Quote</a>
      <a href={company.phoneHref} class="btn border-2 border-white bg-transparent text-white hover:bg-white hover:text-[var(--color-flame)]">
        Call {company.phone}
      </a>
    </div>
  </div>
</section>
