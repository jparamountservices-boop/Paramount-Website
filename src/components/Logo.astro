---
/**
 * Brand logo — real Paramount Concrete & Hardscapes logo (transparent PNG,
 * generated from the owner-supplied art at public/images/logo-original.jpeg).
 */
interface Props {
  class?: string;
  /** Tailwind height classes for the logo image. */
  imgClass?: string;
}
const { class: className = '', imgClass = 'h-12 sm:h-16' } = Astro.props;
---

<a
  href="/"
  class:list={['inline-flex items-center', className]}
  aria-label="Paramount Concrete & Hardscapes — home"
>
  <img
    src="/images/logo.png"
    alt="Paramount Concrete & Hardscapes"
    class:list={['w-auto', imgClass]}
    width="640"
    height="340"
    loading="eager"
    decoding="async"
  />
</a>
