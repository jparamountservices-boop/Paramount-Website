---
interface Props {
  items: { name: string; path: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="wrap py-4 text-xs text-[var(--color-concrete-dim)]">
  <ol class="flex flex-wrap items-center gap-1.5">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {i < items.length - 1 ? (
            <a href={item.path} class="transition hover:text-[var(--color-flame)]">{item.name}</a>
          ) : (
            <span class="text-[var(--color-concrete)]">{item.name}</span>
          )}
          {i < items.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
