---
import { company } from '../data/company';
import { hubServices } from '../data/services';
import { serviceAreas } from '../data/serviceAreas';
import SocialLinks from './SocialLinks.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-steel)] bg-[var(--color-graphite)]">
  <div class="wrap grid gap-10 py-14 md:grid-cols-4">
    <div class="md:col-span-1">
      <Logo />
      <p class="mt-4 text-sm leading-relaxed text-[var(--color-concrete-dim)]">{company.description}</p>
      <SocialLinks class="mt-5" />
    </div>

    <div>
      <p class="mb-3 text-sm font-bold uppercase tracking-wider text-[var(--color-bone)]">Services</p>
      <ul class="space-y-2 text-sm text-[var(--color-concrete)]">
        {hubServices.map((s) => (
          <li><a href={`/${s.path}/`} class="transition hover:text-[var(--color-flame)]">{s.navLabel.replace(' (overview)', '')}</a></li>
        ))}
        <li><a href="/decks/" class="transition hover:text-[var(--color-flame)]">Decks</a></li>
        <li><a href="/masonry/" class="transition hover:text-[var(--color-flame)]">Masonry</a></li>
      </ul>
    </div>

    <div>
      <p class="mb-3 text-sm font-bold uppercase tracking-wider text-[var(--color-bone)]">Service Areas</p>
      <ul class="space-y-2 text-sm text-[var(--color-concrete)]">
        {serviceAreas.map((a) => (
          <li><a href={`/service-area/${a.slug}/`} class="transition hover:text-[var(--color-flame)]">{a.city}, TN</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="mb-3 text-sm font-bold uppercase tracking-wider text-[var(--color-bone)]">Get In Touch</p>
      <ul class="space-y-2 text-sm text-[var(--color-concrete)]">
        <li><a href={company.phoneHref} class="font-bold text-[var(--color-bone)] transition hover:text-[var(--color-flame)]">{company.phone}</a></li>
        <li><a href={`mailto:${company.email}`} class="transition hover:text-[var(--color-flame)]">{company.email}</a></li>
        <li>{company.address.street}<br />{company.address.city}, {company.address.state} {company.address.zip}</li>
      </ul>
      <div class="mt-4 text-sm text-[var(--color-concrete-dim)]">
        {company.hoursHuman.map((h) => (
          <div class="flex justify-between gap-4"><span>{h.label}</span><span>{h.value}</span></div>
        ))}
      </div>
      <a href="/contact/" class="btn btn-primary mt-5 w-full text-sm">Get a Free Quote</a>
    </div>
  </div>

  <div class="border-t border-[var(--color-steel)]">
    <div class="wrap flex flex-col items-center justify-between gap-2 py-5 text-xs text-[var(--color-concrete-dim)] sm:flex-row">
      <p>© {year} {company.legalName}. Licensed &amp; insured. All rights reserved.</p>
      <p>Concrete &amp; hardscape contractor serving Knoxville &amp; East Tennessee.</p>
    </div>
  </div>
</footer>
