---
import { company } from '../data/company';
---

<!-- Mobile-only sticky lead bar -->
<div class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-2 border-t border-[var(--color-steel)] bg-[var(--color-graphite)] lg:hidden">
  <a href={company.phoneHref} class="flex items-center justify-center gap-2 py-3 text-sm font-bold text-[var(--color-bone)]">
    <svg viewBox="0 0 24 24" class="h-4 w-4 text-[var(--color-flame)]" fill="currentColor"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11 11 0 0 0 3.5.56 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.2.2 2.4.56 3.5a1 1 0 0 1-.24 1l-2.2 2.3Z"/></svg>
    Call Now
  </a>
  <a href="/contact/" class="flex items-center justify-center gap-2 bg-[var(--color-flame)] py-3 text-sm font-bold text-white">
    Free Quote
  </a>
</div>
<div class="h-14 lg:hidden" aria-hidden="true"></div>
