<div class:list={['flex items-center gap-3', className]}>
  {
    socialLinks.map((s) => (
      <a
        href={s.url}
        target="_blank"
        rel="noopener noreferrer me"
        aria-label={`Paramount on ${s.name}`}
        class="grid h-9 w-9 place-items-center rounded-full border border-[var(--color-steel)] text-[var(--color-concrete)] transition hover:border-[var(--color-flame)] hover:text-[var(--color-flame)]"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
          <path d={icons[s.key]} />
        </svg>
      </a>
    ))
  }
</div>
