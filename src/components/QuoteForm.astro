---
/**
 * Lead-capture quote form — wired for Netlify Forms.
 * Netlify auto-detects the form named "quote" in the built HTML and captures
 * every submission (email notifications configured in the Netlify dashboard →
 * Forms → Notifications). On success it redirects to /thank-you/.
 */
import { services } from '../data/services';
import { company } from '../data/company';

interface Props {
  compact?: boolean;
  /**
   * Optional lead-source tag (e.g. a campaign name). When set, it's submitted
   * as a hidden `source` field so you can see where the lead came from in the
   * Netlify Forms dashboard. Also mirrored into `public/__forms.html` so
   * Netlify detects the field at deploy time.
   */
  source?: string;
  /** navLabel of a service to pre-select in the dropdown (e.g. on landing pages). */
  defaultService?: string;
}
const { compact = false, source, defaultService } = Astro.props;

// Grouped service options — Outdoor Living first (repositioning). Option
// values stay equal to each service's navLabel so `defaultService` pre-select
// (used on PPC landing pages) keeps working.
const optionGroupOrder = ['Outdoor Living', 'Pavers', 'Concrete', 'Hardscapes'] as const;
const serviceGroups = optionGroupOrder.map((g) => ({
  label: g,
  options: services.filter((s) => s.navGroup === g && !s.isHub && !s.hideFromMenus).map((s) => s.navLabel),
}));

const budgetOptions = ['$5,000 – $15,000', '$15,000 – $25,000', '$25,000 – $50,000', '$50,000+'];
---

<form
  name="quote"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  action="/thank-you/"
  class="grid gap-4"
>
  <input type="hidden" name="form-name" value="quote" />
  {source && <input type="hidden" name="source" value={source} />}
  <!-- Honeypot: bots fill this, humans don't. -->
  <p class="hidden" aria-hidden="true"><label>Don’t fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="mb-1 block text-sm font-semibold text-[var(--color-bone)]">Name</span>
      <input required name="name" type="text" autocomplete="name" class="w-full rounded-lg border border-[var(--color-steel)] bg-[var(--color-ink)] px-3 py-2.5 text-[var(--color-bone)] outline-none focus:border-[var(--color-flame)]" />
    </label>
    <label class="block">
      <span class="mb-1 block text-sm font-semibold text-[var(--color-bone)]">Phone</span>
      <input required name="phone" type="tel" autocomplete="tel" class="w-full rounded-lg border border-[var(--color-steel)] bg-[var(--color-ink)] px-3 py-2.5 text-[var(--color-bone)] outline-none focus:border-[var(--color-flame)]" />
    </label>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="mb-1 block text-sm font-semibold text-[var(--color-bone)]">Email</span>
      <input required name="email" type="email" autocomplete="email" class="w-full rounded-lg border border-[var(--color-steel)] bg-[var(--color-ink)] px-3 py-2.5 text-[var(--color-bone)] outline-none focus:border-[var(--color-flame)]" />
    </label>
    <label class="block">
      <span class="mb-1 block text-sm font-semibold text-[var(--color-bone)]">Property address</span>
      <input name="address" type="text" autocomplete="street-address" placeholder="Street, city — e.g. 123 Oak Dr, Farragut" class="w-full rounded-lg border border-[var(--color-steel)] bg-[var(--color-ink)] px-3 py-2.5 text-[var(--color-bone)] outline-none focus:border-[var(--color-flame)]" />
    </label>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="mb-1 block text-sm font-semibold text-[var(--color-bone)]">What can we build for you?</span>
      <select name="service" class="w-full rounded-lg border border-[var(--color-steel)] bg-[var(--color-ink)] px-3 py-2.5 text-[var(--color-bone)] outline-none focus:border-[var(--color-flame)]">
        <option value="">Select a service…</option>
        {serviceGroups.map((g) => (
          <optgroup label={g.label}>
            {g.options.map((label) => (
              <option value={label} selected={defaultService === label}>{label}</option>
            ))}
          </optgroup>
        ))}
        <option value="Other">Something else</option>
      </select>
    </label>

    <label class="block">
      <span class="mb-1 block text-sm font-semibold text-[var(--color-bone)]">Estimated budget</span>
      <select required name="budget" class="w-full rounded-lg border border-[var(--color-steel)] bg-[var(--color-ink)] px-3 py-2.5 text-[var(--color-bone)] outline-none focus:border-[var(--color-flame)]">
        <option value="" disabled selected>Select a range…</option>
        {budgetOptions.map((b) => (
          <option value={b}>{b}</option>
        ))}
      </select>
    </label>
  </div>

  <label class="block">
    <span class="mb-1 block text-sm font-semibold text-[var(--color-bone)]">Describe your project</span>
    <span class="mb-2 block text-xs text-[var(--color-concrete-dim)]">Please describe your project as best as possible in this area — the more detail, the better we can help.</span>
    <textarea name="details" rows={compact ? 3 : 5} class="w-full rounded-lg border border-[var(--color-steel)] bg-[var(--color-ink)] px-3 py-2.5 text-[var(--color-bone)] outline-none focus:border-[var(--color-flame)]" placeholder="Size or area, location, materials you like, timeline, and anything else that helps us picture it…"></textarea>
  </label>

  <button type="submit" class="btn btn-primary w-full text-base">Request My Free Phone Consultation</button>
  <p class="text-center text-xs text-[var(--color-concrete-dim)]">
    We’ll call to talk through your project before anything else. Prefer to talk now? Call
    <a href={company.phoneHref} class="font-semibold text-[var(--color-flame-300)]">{company.phone}</a>.
  </p>
  <p class="rounded-lg bg-[var(--color-graphite-2)] px-3 py-2 text-center text-xs text-[var(--color-bone)]">
    📷 <strong>Have photos or measurements?</strong> Text them to
    <a href={company.phoneHref} class="font-semibold text-[var(--color-flame-300)]">{company.phone}</a>
    for a faster, more accurate price.
  </p>
</form>
