---
/**
 * Portfolio grid. Auto-loads photos from src/assets/projects/<folder>/ — drop
 * images into the right folder and they appear here automatically, optimized to
 * WebP with a thumbnail + a larger lightbox version. Until photos exist, it
 * shows labeled placeholder tiles so the layout is ready.
 * See docs/deployment/photos.md.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { catByFolder, captionFromFilename, filterGroups } from '../data/projectCategories';
import { gallery as placeholders } from '../data/gallery';

interface Props {
  limit?: number;
  showFilters?: boolean;
}
const { limit, showFilters = true } = Astro.props;

// Eager-glob every project photo. Key = file path; value = { default: ImageMetadata }.
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projects/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

type Tile = { thumb: string; full: string; alt: string; label: string; group: string; href: string; w: number; h: number };
let tiles: Tile[] = [];

for (const [path, mod] of Object.entries(modules)) {
  const parts = path.split('/');
  const filename = parts.pop()!;
  const folder = parts.pop()!;
  const cat = catByFolder(folder);
  if (!cat) continue;
  const meta = mod.default;
  const caption = captionFromFilename(filename) || cat.label;
  const alt = `${caption} by Paramount Concrete & Hardscapes, Knoxville TN`;
  const thumb = await getImage({ src: meta, width: 800, format: 'webp', quality: 78 });
  const full = await getImage({ src: meta, width: 1600, format: 'webp', quality: 82 });
  tiles.push({ thumb: thumb.src, full: full.src, alt, label: caption, group: cat.group, href: cat.href, w: 4, h: 3 });
  // (sort key kept simple via filename order below)
  (tiles[tiles.length - 1] as any)._sort = folder + '/' + filename;
}
tiles.sort((a, b) => ((a as any)._sort < (b as any)._sort ? -1 : 1));

const hasPhotos = tiles.length > 0;
if (limit) tiles = tiles.slice(0, limit);
const placeholderItems = limit ? placeholders.slice(0, limit) : placeholders;
const groups = filterGroups;
---

<div>
  {showFilters && hasPhotos && (
    <div class="mb-8 flex flex-wrap gap-2" role="tablist" aria-label="Filter projects">
      <button class="gallery-filter rounded-full border border-[var(--color-flame)] bg-[var(--color-flame)] px-4 py-1.5 text-sm font-semibold text-white" data-filter="all">All</button>
      {groups.map((c) => (
        <button class="gallery-filter rounded-full border border-[var(--color-steel)] px-4 py-1.5 text-sm font-semibold text-[var(--color-concrete)] transition hover:border-[var(--color-flame)]" data-filter={c}>{c}</button>
      ))}
    </div>
  )}

  <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4" id="gallery-grid">
    {hasPhotos
      ? tiles.map((t) => (
          <figure class="gallery-item group overflow-hidden rounded-xl border border-[var(--color-steel)] bg-[var(--color-graphite-2)]" data-category={t.group}>
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={t.thumb}
                alt={t.alt}
                loading="lazy"
                decoding="async"
                class="gallery-photo h-full w-full cursor-zoom-in object-cover transition duration-300 group-hover:scale-105"
                data-full={t.full}
                data-caption={t.label}
              />
              <span class="pointer-events-none absolute right-2 top-2 grid h-8 w-8 place-items-center rounded-full bg-black/55 text-white backdrop-blur-sm" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M11 8v6M8 11h6"/></svg>
              </span>
            </div>
            <figcaption class="p-3">
              <a href={t.href} class="block">
                <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-flame)]">{t.group}</span>
                <span class="block font-bold leading-tight text-[var(--color-bone)] group-hover:text-[var(--color-flame)]">{t.label}</span>
              </a>
            </figcaption>
          </figure>
        ))
      : placeholderItems.map((item) => (
          <figure class="gallery-item group relative flex aspect-[4/3] flex-col justify-end overflow-hidden rounded-xl border border-[var(--color-steel)] bg-[var(--color-graphite-2)]" data-category={item.category}>
            <div class="pointer-events-none absolute inset-0 opacity-40" style="background-image: radial-gradient(80% 80% at 50% 0%, rgba(255,92,26,0.28), transparent 70%);" />
            <figcaption class="relative z-10 bg-gradient-to-t from-black/80 to-transparent p-4">
              <a href={item.href} class="block">
                <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-flame)]">{item.category}</span>
                <span class="block font-bold text-[var(--color-bone)] group-hover:text-[var(--color-flame)]">{item.title}</span>
                {item.location && <span class="text-xs text-[var(--color-concrete-dim)]">{item.location}, TN</span>}
              </a>
            </figcaption>
          </figure>
        ))}
  </div>

  {!hasPhotos && (
    <p class="mt-6 text-center text-sm text-[var(--color-concrete-dim)]">
      Project photos coming soon — real photos drop straight into these categories.
    </p>
  )}
</div>

<!-- Lightbox -->
<div id="lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 p-4" role="dialog" aria-modal="true" aria-label="Project photo">
  <button id="lightbox-close" class="absolute right-4 top-4 grid h-11 w-11 place-items-center rounded-full border border-white/30 text-2xl text-white" aria-label="Close">×</button>
  <figure class="max-h-full max-w-5xl text-center">
    <img id="lightbox-img" src="" alt="" class="mx-auto max-h-[80vh] w-auto rounded-lg" />
    <figcaption id="lightbox-caption" class="mt-3 text-sm text-white/80"></figcaption>
  </figure>
</div>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.gallery-filter');
  const tiles = document.querySelectorAll<HTMLElement>('.gallery-item');
  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      filters.forEach((b) => {
        b.classList.remove('bg-[var(--color-flame)]', 'text-white', 'border-[var(--color-flame)]');
        b.classList.add('border-[var(--color-steel)]', 'text-[var(--color-concrete)]');
      });
      btn.classList.add('bg-[var(--color-flame)]', 'text-white', 'border-[var(--color-flame)]');
      btn.classList.remove('border-[var(--color-steel)]', 'text-[var(--color-concrete)]');
      tiles.forEach((t) => {
        t.style.display = f === 'all' || t.dataset.category === f ? '' : 'none';
      });
    });
  });

  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lbCap = document.getElementById('lightbox-caption');
  const close = () => lb?.classList.replace('flex', 'hidden');
  document.querySelectorAll<HTMLImageElement>('.gallery-photo').forEach((img) => {
    img.addEventListener('click', () => {
      if (!lb || !lbImg) return;
      lbImg.src = img.dataset.full || img.src;
      lbImg.alt = img.alt;
      if (lbCap) lbCap.textContent = img.dataset.caption || '';
      lb.classList.replace('hidden', 'flex');
    });
  });
  document.getElementById('lightbox-close')?.addEventListener('click', close);
  lb?.addEventListener('click', (e) => { if (e.target === lb) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
</script>
