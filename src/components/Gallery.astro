---
/**
 * Filterable portfolio grid with a lightweight lightbox.
 * Tiles with an `image` render the photo (lazy-loaded); tiles without render a
 * labeled placeholder so the layout is ready before real photos are added.
 */
import { gallery, galleryCategories } from '../data/gallery';

interface Props {
  limit?: number;
  showFilters?: boolean;
}
const { limit, showFilters = true } = Astro.props;
const items = limit ? gallery.slice(0, limit) : gallery;
---

<div>
  {showFilters && (
    <div class="mb-8 flex flex-wrap gap-2" role="tablist" aria-label="Filter projects">
      <button class="gallery-filter rounded-full border border-[var(--color-flame)] bg-[var(--color-flame)] px-4 py-1.5 text-sm font-semibold text-white" data-filter="all">All</button>
      {galleryCategories.map((c) => (
        <button class="gallery-filter rounded-full border border-[var(--color-steel)] px-4 py-1.5 text-sm font-semibold text-[var(--color-concrete)] transition hover:border-[var(--color-flame)]" data-filter={c}>{c}</button>
      ))}
    </div>
  )}

  <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4" id="gallery-grid">
    {
      items.map((item) => (
        <figure class="gallery-item group relative flex aspect-[4/3] flex-col justify-end overflow-hidden rounded-xl border border-[var(--color-steel)] bg-[var(--color-graphite-2)]" data-category={item.category}>
          {item.image ? (
            <img
              src={item.image}
              alt={item.alt}
              loading="lazy"
              decoding="async"
              class="gallery-photo absolute inset-0 h-full w-full cursor-zoom-in object-cover transition duration-300 group-hover:scale-105"
              data-full={item.image}
              data-caption={`${item.title}${item.location ? ' · ' + item.location + ', TN' : ''}`}
            />
          ) : (
            <div class="pointer-events-none absolute inset-0 opacity-40" style="background-image: radial-gradient(80% 80% at 50% 0%, rgba(255,92,26,0.28), transparent 70%);" />
          )}
          <figcaption class="relative z-10 bg-gradient-to-t from-black/80 to-transparent p-4">
            <a href={item.href} class="block">
              <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-flame)]">{item.category}</span>
              <span class="block font-bold text-[var(--color-bone)] group-hover:text-[var(--color-flame)]">{item.title}</span>
              {item.location && <span class="text-xs text-[var(--color-concrete-dim)]">{item.location}, TN</span>}
            </a>
          </figcaption>
        </figure>
      ))
    }
  </div>
</div>

<!-- Lightbox -->
<div id="lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 p-4" role="dialog" aria-modal="true" aria-label="Project photo">
  <button id="lightbox-close" class="absolute right-4 top-4 grid h-11 w-11 place-items-center rounded-full border border-white/30 text-2xl text-white" aria-label="Close">×</button>
  <figure class="max-h-full max-w-5xl text-center">
    <img id="lightbox-img" src="" alt="" class="mx-auto max-h-[80vh] w-auto rounded-lg" />
    <figcaption id="lightbox-caption" class="mt-3 text-sm text-white/80"></figcaption>
  </figure>
</div>

<script>
  // Category filter
  const filters = document.querySelectorAll<HTMLButtonElement>('.gallery-filter');
  const tiles = document.querySelectorAll<HTMLElement>('.gallery-item');
  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      filters.forEach((b) => {
        b.classList.remove('bg-[var(--color-flame)]', 'text-white', 'border-[var(--color-flame)]');
        b.classList.add('border-[var(--color-steel)]', 'text-[var(--color-concrete)]');
      });
      btn.classList.add('bg-[var(--color-flame)]', 'text-white', 'border-[var(--color-flame)]');
      btn.classList.remove('border-[var(--color-steel)]', 'text-[var(--color-concrete)]');
      tiles.forEach((t) => {
        t.style.display = f === 'all' || t.dataset.category === f ? '' : 'none';
      });
    });
  });

  // Lightbox
  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lbCap = document.getElementById('lightbox-caption');
  const close = () => lb?.classList.replace('flex', 'hidden');
  document.querySelectorAll<HTMLImageElement>('.gallery-photo').forEach((img) => {
    img.addEventListener('click', () => {
      if (!lb || !lbImg) return;
      lbImg.src = img.dataset.full || img.src;
      lbImg.alt = img.alt;
      if (lbCap) lbCap.textContent = img.dataset.caption || '';
      lb.classList.replace('hidden', 'flex');
    });
  });
  document.getElementById('lightbox-close')?.addEventListener('click', close);
  lb?.addEventListener('click', (e) => { if (e.target === lb) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
</script>
