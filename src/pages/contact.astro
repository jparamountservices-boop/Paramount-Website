---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { company, serviceAreaLabel, mapEmbedUrl, googleListingUrl } from '../data/company';
import { breadcrumbSchema } from '../lib/schema';

const path = '/contact/';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path },
];
---

<BaseLayout
  title="Contact | Free Concrete & Hardscape Estimate | Knoxville TN | Paramount"
  description="Get a free, no-pressure estimate for concrete, pavers, patios, retaining walls or outdoor living in Knoxville & East TN. Call (865) 237-9770 or request a quote online."
  path={path}
  schemas={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="wrap grid gap-12 py-10 lg:grid-cols-[1fr_1.1fr]">
    <div>
      <p class="eyebrow">Let’s talk it through</p>
      <h1 class="mt-3 text-4xl font-black sm:text-5xl">Book your free phone consultation</h1>
      <p class="mt-5 text-lg text-[var(--color-concrete)]">
        Every project starts with a conversation — not a surprise visit. Tell us what you’re thinking
        and we’ll call to talk through your ideas, options and ballpark pricing before we ever come out.
        Have a few photos and rough measurements? Even better — they help us give you a more accurate
        price up front.
      </p>

      <div class="mt-8 space-y-5">
        <div>
          <p class="text-sm font-bold uppercase tracking-wider text-[var(--color-flame)]">Call or text</p>
          <a href={company.phoneHref} class="text-2xl font-black text-[var(--color-bone)] hover:text-[var(--color-flame)]">{company.phone}</a>
        </div>
        <div>
          <p class="text-sm font-bold uppercase tracking-wider text-[var(--color-flame)]">Email</p>
          <a href={`mailto:${company.email}`} class="text-lg text-[var(--color-concrete)] hover:text-[var(--color-flame)]">{company.email}</a>
        </div>
        <div>
          <p class="text-sm font-bold uppercase tracking-wider text-[var(--color-flame)]">Service area</p>
          <p class="text-[var(--color-concrete)]">Proudly serving {serviceAreaLabel} — we bring the crew and equipment to you.</p>
        </div>
        <div>
          <p class="text-sm font-bold uppercase tracking-wider text-[var(--color-flame)]">Hours</p>
          {company.hoursHuman.map((h) => (
            <p class="text-[var(--color-concrete)]"><span class="inline-block w-24 text-[var(--color-concrete-dim)]">{h.label}</span>{h.value}</p>
          ))}
        </div>
      </div>
    </div>

    <div class="rounded-2xl border border-[var(--color-steel)] bg-[var(--color-graphite)] p-7">
      <h2 class="text-xl font-extrabold text-[var(--color-bone)]">Request your free phone consultation</h2>
      <p class="mb-5 mt-1 text-sm text-[var(--color-concrete-dim)]">We typically respond the same or next business day.</p>
      <QuoteForm />
    </div>
  </section>

  <!-- Where we work -->
  <section class="wrap pb-14">
    <div class="overflow-hidden rounded-2xl border border-[var(--color-steel)] bg-[var(--color-graphite)]">
      <div class="flex flex-col items-start justify-between gap-4 p-6 sm:flex-row sm:items-center">
        <div>
          <p class="text-sm font-bold uppercase tracking-wider text-[var(--color-flame)]">Where we work</p>
          <p class="mt-1 text-[var(--color-concrete)]">Proudly serving {serviceAreaLabel} — we bring the crew and equipment to you.</p>
        </div>
        <a href={googleListingUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary text-sm">View us on Google</a>
      </div>
      <iframe
        title={`Paramount Concrete & Hardscapes service area — ${company.address.city}, ${company.address.state}`}
        src={mapEmbedUrl}
        width="100%"
        height="360"
        style="border:0;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </section>
</BaseLayout>
