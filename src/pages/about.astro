---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TrustBar from '../components/TrustBar.astro';
import CtaBand from '../components/CtaBand.astro';
import { company } from '../data/company';
import { breadcrumbSchema } from '../lib/schema';

const path = '/about/';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path },
];

const values = [
  { t: 'Do it right or don’t do it', d: 'We’d rather turn down a job than cut corners on base prep or drainage. The parts you can’t see are the parts that last.' },
  { t: 'Straight talk', d: 'Honest estimates, honest timelines, honest answers about what will and won’t work for your property.' },
  { t: 'Respect your home', d: 'We keep the site clean, protect your landscaping, and treat your property like it’s ours.' },
  { t: 'Stand behind the work', d: 'Our name is on every project. We back it with a workmanship warranty and we answer the phone after the job’s done.' },
];
---

<BaseLayout
  title="About Paramount Concrete & Hardscapes | Knoxville TN Contractor"
  description="Meet Paramount Concrete & Hardscapes — a Knoxville, TN concrete and hardscape team obsessed with base prep, drainage and craftsmanship that lasts in East Tennessee."
  path={path}
  schemas={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="wrap py-10">
    <p class="eyebrow">About us</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-black sm:text-5xl">A Knoxville crew that builds concrete &amp; hardscapes the right way</h1>
  </section>

  <TrustBar />

  <section class="wrap prose-dark py-14">
    <div class="mx-auto max-w-3xl">
      <p>
        Paramount Concrete &amp; Hardscapes designs and builds outdoor spaces for homeowners across
        Knoxville and East Tennessee — concrete, pavers, retaining walls, patios, fire features
        and outdoor kitchens. We started with a simple idea: most concrete and hardscape
        failures aren’t bad luck, they’re bad prep. So we obsess over the parts nobody sees.
      </p>
      <p>
        Our clay soil holds water. Our winters freeze and thaw. Our lots are hilly. Those conditions
        punish shortcuts — the un-compacted base, the missing drain line, the slab that’s an inch too
        thin. We build for those conditions on every project, so your driveway, patio or wall still
        looks right a decade from now.
      </p>
      <p>
        You’ll work with our crew from the first estimate to the final joint — the same people
        homeowners name in their reviews. We’re fully licensed and insured, we back our work with a
        warranty, and we’d rather earn your next project than win this one on a lowball.
      </p>

      <h2>What we stand for</h2>
    </div>

    <div class="mx-auto mt-6 grid max-w-4xl gap-6 sm:grid-cols-2">
      {
        values.map((v) => (
          <div class="rounded-xl border border-[var(--color-steel)] bg-[var(--color-graphite)] p-6">
            <p class="text-lg font-extrabold text-[var(--color-bone)]">{v.t}</p>
            <p class="mt-2 text-sm text-[var(--color-concrete-dim)]">{v.d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <CtaBand heading="Let’s build something that lasts." />
</BaseLayout>
