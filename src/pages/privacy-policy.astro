---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { company } from '../data/company';
import { breadcrumbSchema } from '../lib/schema';

const path = '/privacy-policy/';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Privacy Policy', path },
];
const updated = 'November 8, 2026';
---

<BaseLayout
  title="Privacy Policy | Paramount Concrete & Hardscapes"
  description="How Paramount Concrete & Hardscapes collects, uses and protects the information you share through our website, ads and lead forms."
  path={path}
  schemas={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="wrap py-12 md:py-16">
    <article class="mx-auto max-w-3xl space-y-8 leading-relaxed text-[var(--color-concrete)]">
      <header>
        <h1 class="text-4xl font-black text-[var(--color-bone)] md:text-5xl">Privacy Policy</h1>
        <p class="mt-3 text-sm">Last updated: {updated}</p>
      </header>

      <p>
        {company.name} ("we," "us," "our") respects your privacy. This policy explains what information we
        collect when you visit {company.url.replace('https://', '')}, contact us, or respond to one of our ads or
        lead forms (including forms on Facebook and Instagram), and how we use it.
      </p>

      <div>
        <h2 class="text-2xl font-bold text-[var(--color-bone)]">Information we collect</h2>
        <ul class="mt-3 list-disc space-y-2 pl-6">
          <li>
            <strong class="text-[var(--color-bone)]">Information you give us:</strong> your name, phone number, email
            address, property address or area, and details about your project (for example project type, size, timing,
            photos or notes) when you fill out a form, call, text or email us.
          </li>
          <li>
            <strong class="text-[var(--color-bone)]">Lead forms on Facebook and Instagram:</strong> when you submit one
            of our forms on Meta's platforms, Meta shares the answers you submitted with us. Meta's own use of your
            information is covered by Meta's Privacy Policy.
          </li>
          <li>
            <strong class="text-[var(--color-bone)]">Website usage information:</strong> like most websites, we and our
            service providers may automatically collect basic technical information such as browser type, device,
            pages visited and how you arrived at our site. We may use tools such as Google Analytics, Google Ads
            conversion tracking, Microsoft Clarity and the Meta Pixel, which can use cookies or similar technologies.
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-[var(--color-bone)]">How we use your information</h2>
        <ul class="mt-3 list-disc space-y-2 pl-6">
          <li>To respond to your request, give you a quote and schedule consultations or work.</li>
          <li>To contact you by phone, text or email about your project and any offer you asked about.</li>
          <li>To provide, manage and invoice the services you hire us for.</li>
          <li>To improve our website, advertising and customer service.</li>
          <li>To comply with legal obligations and protect our rights.</li>
        </ul>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-[var(--color-bone)]">How we share your information</h2>
        <p class="mt-3">
          <strong class="text-[var(--color-bone)]">We do not sell your personal information.</strong> We only share it
          with service providers that help us run our business (for example website hosting, email, scheduling,
          estimating, payment and advertising platforms), with suppliers or subcontractors when needed to complete
          your project, or when required by law.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-[var(--color-bone)]">Texts and calls</h2>
        <p class="mt-3">
          If you give us your phone number, we may call or text you about your request. Message and data rates may
          apply. You can reply STOP to any text or ask us at any time to stop contacting you.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-[var(--color-bone)]">Cookies and your choices</h2>
        <p class="mt-3">
          You can block or delete cookies in your browser settings. You can also manage ad preferences in your
          Facebook, Instagram and Google account settings. Blocking cookies won't stop you from contacting us.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-[var(--color-bone)]">Keeping your information safe</h2>
        <p class="mt-3">
          We use reasonable measures to protect your information and keep it only as long as we need it for the
          purposes above or as required by law. No method of storage or transmission is 100% secure.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-[var(--color-bone)]">Your rights</h2>
        <p class="mt-3">
          You can ask us to tell you what information we have about you, correct it, or delete it. Just contact us
          using the details below and we'll take care of it.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-[var(--color-bone)]">Children</h2>
        <p class="mt-3">
          Our services are for adults. We do not knowingly collect information from children under 13.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-[var(--color-bone)]">Changes to this policy</h2>
        <p class="mt-3">
          We may update this policy from time to time. The "last updated" date above shows when it last changed.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-[var(--color-bone)]">Contact us</h2>
        <p class="mt-3">
          {company.name}<br />
          {company.address.street}, {company.address.city}, {company.address.state} {company.address.zip}<br />
          Phone: <a href={company.phoneHref} class="text-[var(--color-flame-300)] underline">{company.phone}</a><br />
          Email: <a href={`mailto:${company.email}`} class="text-[var(--color-flame-300)] underline">{company.email}</a>
        </p>
      </div>
    </article>
  </section>
</BaseLayout>
