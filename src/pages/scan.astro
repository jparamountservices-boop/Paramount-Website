---
/**
 * NEIGHBORHOOD LANDING PAGE — where the yard-sign QR code points.
 *
 * Concept: a reusable "We Built This" sign goes in every finished customer's
 * yard. Neighbors and drive-by traffic scan it and land here — a neighborhood
 * showcase of recent work with one low-friction ask: book a free phone
 * consultation for concrete, pavers, retaining walls or outdoor living.
 * Mobile-first, because ~everyone scanning is on a phone.
 *
 * noindex: campaign page tied to printed signage — kept out of the index and
 * sitemap so it doesn't compete with the SEO pages.
 *
 * ── EDIT THE OFFER HERE ──────────────────────────────────────────────────
 * `sweetener` is the small incentive. Set it to '' to promote ONLY the free
 * phone consultation with no discount. Keep it honest — only promise what
 * you'll actually honor.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import Gallery from '../components/Gallery.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { company } from '../data/company';

const offer = {
  sweetener: '$250 off your project', // small incentive; set to '' for consult-only
  validNote: 'Just mention this page when we talk.',
};

const source = 'Yard Sign QR — Neighborhood Page';
const path = '/scan/';

const categories = [
  { t: 'Concrete', d: 'Driveways, patios, and stamped & decorative work built to last.', href: '/concrete/' },
  { t: 'Pavers', d: 'Patios, driveways and walkways that lock in for decades.', href: '/pavers/' },
  { t: 'Retaining Walls', d: 'Block & stone walls engineered for our clay soil and slopes.', href: '/retaining-walls/' },
  { t: 'Outdoor Living', d: 'Fire pits, seat walls and outdoor spaces built to gather around.', href: '/hardscapes/' },
];
---

<BaseLayout
  title="See Our Neighborhood Work | Free Phone Consultation | Paramount Concrete & Hardscapes"
  description="You spotted our work in the neighborhood. See recent concrete, paver, retaining wall and outdoor-living projects across Knoxville & East TN — and book a free phone consultation."
  path={path}
  noindex={true}
>
  <!-- HERO: neighborhood greeting -->
  <section class="relative overflow-hidden border-b border-[var(--color-steel)]">
    <div class="absolute inset-0">
      <img src="/images/hero-home.jpg" alt="" aria-hidden="true" class="h-full w-full object-cover" loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-b from-black/85 via-black/70 to-black/85"></div>
    </div>

    <div class="wrap relative py-14 sm:py-20">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-[var(--color-flame)]">From your neighborhood 👋</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-black leading-[1.05] text-white sm:text-6xl">
        See what we've built<br /><span class="text-[var(--color-flame)]">right around you.</span>
      </h1>
      <p class="mt-5 max-w-xl text-lg text-white/90">
        That fresh driveway, patio or wall nearby? That's our work. If you've been
        thinking about your own place, let's talk — a free phone consultation, no
        drive-out and no pressure.
      </p>

      <!-- Offer chip -->
      <div class="mt-8 inline-flex flex-wrap items-center gap-3 rounded-2xl border-2 border-[var(--color-flame)] bg-black/40 px-5 py-4 backdrop-blur">
        <span class="text-lg font-black text-white">FREE phone consultation</span>
        {offer.sweetener && (
          <span class="rounded-lg bg-[var(--color-flame)] px-3 py-1.5 text-sm font-black uppercase tracking-wide text-white">+ {offer.sweetener}</span>
        )}
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#book" class="btn btn-primary text-base">Book my free consultation</a>
        <a href={company.phoneHref} class="btn border-2 border-white/70 text-base text-white hover:bg-white hover:text-[var(--color-bone)]">Call {company.phone}</a>
      </div>
      <p class="mt-5 text-sm text-white/80">★★★★★ {company.rating.value}/5 · Licensed &amp; insured · {company.trust.projectsCompleted} projects built in East TN</p>
    </div>
  </section>

  <TrustBar />

  <!-- WHAT WE BUILD — the four service lines -->
  <section class="wrap py-14">
    <p class="eyebrow">What we build</p>
    <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">One crew for the whole outdoor space</h2>
    <p class="mt-4 max-w-2xl text-[var(--color-concrete)]">
      Whatever you're picturing out back or out front, we build it — and we build the base
      underneath it to last through East Tennessee's clay and freeze-thaw winters.
    </p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {categories.map((c) => (
        <a href={c.href} class="group flex items-start justify-between gap-4 rounded-2xl border border-[var(--color-steel)] bg-[var(--color-graphite)] p-6 transition hover:-translate-y-1 hover:border-[var(--color-flame)]">
          <div>
            <h3 class="text-xl font-black group-hover:text-[var(--color-flame)]">{c.t}</h3>
            <p class="mt-2 text-[var(--color-concrete)]">{c.d}</p>
          </div>
          <span class="mt-1 text-2xl font-black text-[var(--color-flame)]">→</span>
        </a>
      ))}
    </div>
  </section>

  <!-- PROOF: recent projects -->
  <section class="bg-[var(--color-graphite)] py-14">
    <div class="wrap">
      <p class="eyebrow">Recent work nearby</p>
      <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Straight from the neighborhood</h2>
      <p class="mt-4 max-w-2xl text-[var(--color-concrete)]">
        Real projects we've built across Knoxville, Farragut, Maryville and the rest of East
        Tennessee. Yours could be next.
      </p>
      <div class="mt-8">
        <Gallery limit={6} showFilters={false} />
      </div>
      <div class="mt-8">
        <a href="/our-work/" class="btn btn-ghost">See the full portfolio →</a>
      </div>
    </div>
  </section>

  <!-- BOOK: the free consultation -->
  <section id="book" class="wrap py-16">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <div>
        <p class="eyebrow">Let's talk</p>
        <h2 class="mt-3 text-3xl font-black sm:text-4xl">Book your free phone consultation</h2>
        <p class="mt-4 text-lg text-[var(--color-concrete)]">
          Tell us what you're thinking about — concrete, pavers, a wall or an outdoor living
          space — and we'll call to talk it through. No drive-out, no pressure, no obligation.
          {offer.sweetener && <> Booked from this page? Ask about your <strong class="text-[var(--color-bone)]">{offer.sweetener}</strong>.</>}
        </p>
        <ul class="mt-6 space-y-3 text-[var(--color-concrete)]">
          <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 rotate-45 bg-[var(--color-flame)]"></span> A real conversation first — we talk before anyone drives out.</li>
          <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 rotate-45 bg-[var(--color-flame)]"></span> Text photos to {company.phone} for a faster, more accurate price.</li>
          <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 rotate-45 bg-[var(--color-flame)]"></span> Licensed, insured, and backed by our {company.trust.warrantyYears}-year workmanship warranty.</li>
        </ul>
      </div>

      <div class="rounded-2xl border border-[var(--color-steel)] bg-[var(--color-graphite)] p-6 shadow-xl">
        {offer.sweetener && (
          <div class="mb-4 flex items-center justify-between rounded-lg bg-[var(--color-graphite-2)] px-3 py-2">
            <span class="text-sm font-bold text-[var(--color-bone)]">Free consult + {offer.sweetener}</span>
            <span class="rounded bg-[var(--color-flame)] px-2 py-0.5 text-xs font-bold uppercase text-white">Neighbor</span>
          </div>
        )}
        <QuoteForm source={source} />
      </div>
    </div>
  </section>
</BaseLayout>
