---
/**
 * QR LANDING PAGE — the page the yard-sign QR code points to.
 *
 * Concept: someone driving/walking by sees a Paramount yard sign in a
 * neighbor's fresh driveway/patio/wall, scans the code, and lands here. The
 * page greets them as a neighbor, hands them a real reason to act now (the
 * "Neighbor Discount"), proves the work with a photo gallery, and captures the
 * lead. Mobile-first, because ~everyone scanning is on a phone.
 *
 * noindex: this is a campaign page tied to a printed offer — we don't want it
 * competing with the SEO pages or getting indexed as a thin "coupon" page.
 *
 * ── EDIT THE OFFER HERE ──────────────────────────────────────────────────
 * Change the numbers, code, or expiry below and the whole page + coupon
 * updates. Keep it honest — only promise what you'll actually honor.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import Gallery from '../components/Gallery.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { company } from '../data/company';

const offer = {
  amount: '$500',                       // headline discount
  minProject: '$5,000',                 // minimum project the discount applies to
  bonus: 'a FREE on-site design visit', // extra sweetener
  code: 'NEIGHBOR500',                  // the code they mention / enter
  validNote: 'Valid for 30 days from today — mention it when we talk.',
};

const source = 'Yard Sign QR — Neighbor Offer';
const path = '/scan/';

const perks = [
  { t: `${offer.amount} off`, d: `Straight off any project of ${offer.minProject} or more — driveway, patio, pavers, wall or fire feature.` },
  { t: 'Free on-site design', d: 'We come measure, talk drainage and materials, and put a real number in writing — no charge, no pressure.' },
  { t: 'Neighbor priority', d: 'Scanned-in neighbors get first pick of our schedule while our crew is already working in the area.' },
];
---

<BaseLayout
  title={`Neighbor Discount — ${offer.amount} Off | Paramount Concrete & Hardscapes`}
  description={`You scanned a Paramount job in the neighborhood — here's ${offer.amount} off your concrete or hardscape project, plus a free on-site design. Knoxville & East TN.`}
  path={path}
  noindex={true}
>
  <!-- HERO: greet them as a neighbor -->
  <section class="relative overflow-hidden border-b border-[var(--color-steel)]">
    <div class="absolute inset-0">
      <img src="/images/hero-home.jpg" alt="" aria-hidden="true" class="h-full w-full object-cover" loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-b from-black/85 via-black/70 to-black/85"></div>
    </div>

    <div class="wrap relative py-14 sm:py-20">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-[var(--color-flame)]">You scanned the sign 👋</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-black leading-[1.02] text-white sm:text-6xl">
        You just walked past<br /><span class="text-[var(--color-flame)]">our work.</span>
      </h1>
      <p class="mt-5 max-w-xl text-lg text-white/90">
        That fresh driveway, patio or wall nearby? We built it. And since you're a neighbor,
        we set something aside for you.
      </p>

      <!-- The coupon — designed to be screenshot-friendly -->
      <div class="mt-8 max-w-md">
        <div class="relative overflow-hidden rounded-2xl border-2 border-dashed border-[var(--color-flame)] bg-[var(--color-graphite)] p-6 shadow-2xl">
          <div class="absolute -left-3 top-1/2 h-6 w-6 -translate-y-1/2 rounded-full bg-black/85"></div>
          <div class="absolute -right-3 top-1/2 h-6 w-6 -translate-y-1/2 rounded-full bg-black/85"></div>
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[var(--color-forest)]">Neighbor Discount</p>
          <p class="mt-2 text-5xl font-black text-[var(--color-bone)]">{offer.amount} <span class="text-2xl align-middle">off</span></p>
          <p class="mt-1 text-[var(--color-concrete)]">plus {offer.bonus}</p>
          <div class="mt-4 flex items-center gap-3">
            <span class="rounded-lg bg-[var(--color-bone)] px-3 py-1.5 font-mono text-sm font-bold tracking-widest text-white">{offer.code}</span>
            <span class="text-xs text-[var(--color-concrete-dim)]">{offer.validNote}</span>
          </div>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#claim" class="btn btn-primary text-base">Claim my {offer.amount} off</a>
        <a href={company.phoneHref} class="btn border-2 border-white/70 text-base text-white hover:bg-white hover:text-[var(--color-bone)]">Call {company.phone}</a>
      </div>
      <p class="mt-5 text-sm text-white/80">★★★★★ {company.rating.value}/5 · Licensed &amp; insured · {company.trust.projectsCompleted} projects built in East TN</p>
    </div>
  </section>

  <TrustBar />

  <!-- WHAT YOU GET -->
  <section class="wrap py-14">
    <p class="eyebrow">Here's the deal</p>
    <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">What your neighbor code unlocks</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {perks.map((p) => (
        <div class="rounded-2xl border border-[var(--color-steel)] bg-[var(--color-graphite)] p-6">
          <h3 class="text-xl font-black text-[var(--color-flame)]">{p.t}</h3>
          <p class="mt-2 text-[var(--color-concrete)]">{p.d}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 max-w-2xl text-sm text-[var(--color-concrete-dim)]">
      Fine print: {offer.amount} off applies to new projects of {offer.minProject}+ booked with Paramount
      Concrete &amp; Hardscapes. {offer.validNote} One offer per household. Can't be combined with other
      promotions. Just mention code <strong class="text-[var(--color-bone)]">{offer.code}</strong> when we talk.
    </p>
  </section>

  <!-- PROOF: recent projects -->
  <section class="bg-[var(--color-graphite)] py-14">
    <div class="wrap">
      <p class="eyebrow">Recent work nearby</p>
      <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">See what we build</h2>
      <p class="mt-4 max-w-2xl text-[var(--color-concrete)]">
        Driveways, patios, stamped concrete, pavers, retaining walls and fire pits — built across
        Knoxville, Farragut, Maryville and the rest of East Tennessee.
      </p>
      <div class="mt-8">
        <Gallery limit={6} showFilters={false} />
      </div>
      <div class="mt-8">
        <a href="/our-work/" class="btn btn-ghost">See the full portfolio →</a>
      </div>
    </div>
  </section>

  <!-- CLAIM: the lead form -->
  <section id="claim" class="wrap py-16">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <div>
        <p class="eyebrow">Claim it</p>
        <h2 class="mt-3 text-3xl font-black sm:text-4xl">Lock in your {offer.amount} off</h2>
        <p class="mt-4 text-lg text-[var(--color-concrete)]">
          Tell us what you're thinking about and we'll call to talk it through — no drive-out, no
          pressure. Your neighbor code <strong class="text-[var(--color-bone)]">{offer.code}</strong> is
          already attached to this request.
        </p>
        <ul class="mt-6 space-y-3 text-[var(--color-concrete)]">
          <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 rotate-45 bg-[var(--color-flame)]"></span> Free phone consultation first — we talk before anyone drives out.</li>
          <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 rotate-45 bg-[var(--color-flame)]"></span> Text photos to {company.phone} for a faster, more accurate price.</li>
          <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 rotate-45 bg-[var(--color-flame)]"></span> Licensed, insured, and backed by our {company.trust.warrantyYears}-year workmanship warranty.</li>
        </ul>
      </div>

      <div class="rounded-2xl border border-[var(--color-steel)] bg-[var(--color-graphite)] p-6 shadow-xl">
        <div class="mb-4 flex items-center justify-between rounded-lg bg-[var(--color-graphite-2)] px-3 py-2">
          <span class="text-sm font-bold text-[var(--color-bone)]">Neighbor Discount applied</span>
          <span class="rounded bg-[var(--color-flame)] px-2 py-0.5 font-mono text-xs font-bold text-white">{offer.code}</span>
        </div>
        <QuoteForm source={source} />
      </div>
    </div>
  </section>
</BaseLayout>
