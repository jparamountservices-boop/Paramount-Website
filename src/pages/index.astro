---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Gallery from '../components/Gallery.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import { company } from '../data/company';
import { serviceAreas } from '../data/serviceAreas';

const path = '/';

// Three-tier "ways to build your backyard" model, ascending by price so the
// eye lands on the full custom build last. Photo slot optional (add later).
const tiers = [
  {
    name: 'Concrete & Flatwork',
    range: '$8k–$15k',
    href: '/concrete/',
    desc: 'Driveways, slabs, sidewalks, standalone patios and repairs — the durable foundation everything else is built on.',
    examples: ['Driveways & parking pads', 'Patios & slabs', 'Sidewalks & repair'],
    cta: 'Explore concrete',
  },
  {
    name: 'Patio + Cover Package',
    range: '$15k–$25k',
    href: '/outdoor-living/patio-covers/',
    desc: 'A concrete or paver patio paired with an engineered cover — shade, rain protection and lighting, at real value.',
    examples: ['Kit & pergola covers', 'Ceiling fan & lighting', 'Faster, engineered install'],
    cta: 'Explore patio covers',
  },
  {
    name: 'Full Custom Build',
    range: '$25k–$60k+',
    href: '/outdoor-living/backyard-builds/',
    desc: 'Site-built structures, outdoor kitchens, sport courts, walls and lighting — designed and built as one project.',
    examples: ['Outdoor kitchens', 'Backyard sport courts', 'Complete transformations'],
    cta: 'Explore full builds',
  },
];

// Two tracks: phone-first for standard flatwork, design-first for larger
// outdoor-living / custom builds (paid consultation credited to the project).
const flatworkSteps = [
  { n: '01', t: 'Free phone consultation', d: 'Tell us about your project — your space, your ideas, timeline and budget — and we’ll talk through options and ballpark pricing before anyone drives out.' },
  { n: '02', t: 'Photos & measurements', d: 'Send a few photos and rough measurements of the area and we can give you a realistic price range up front.' },
  { n: '03', t: 'On-site measure & written quote', d: 'When it’s a good fit, we take exact measurements, finalize materials and drainage, and put your price in writing.' },
  { n: '04', t: 'Build it to last', d: 'Our crew handles the prep, structure and finish with the details that make it last here — backed by our workmanship warranty.' },
];
const designSteps = [
  { n: '01', t: 'Free phone consultation', d: 'We start with a conversation about your space, your ideas, timeline and a realistic budget range — no charge, no sales visit.' },
  { n: '02', t: 'Paid on-site design consultation', d: 'We walk the lot, shoot grades, and check drainage and access. The consultation fee is credited in full toward your project.' },
  { n: '03', t: 'Design & written proposal', d: 'You get a plan for the whole space and an itemized proposal you can build from — and phase however you’d like.' },
  { n: '04', t: 'Build as one project', d: 'One crew builds the whole space — hardscape, structures, kitchen and lighting — coordinated from first cut to final joint.' },
];

const whyUs = [
  { t: 'Base prep obsessed', d: 'We build from the ground up — compacted base, real drainage, proper reinforcement — because that’s what makes concrete and hardscapes last here.' },
  { t: 'One team, start to finish', d: 'From the first estimate to the final joint, you work with our crew — not a rotating cast of subs.' },
  { t: 'Built for East TN', d: 'Clay soil, freeze-thaw winters, hilly lots — we build for the conditions that break lesser work.' },
  { t: 'Honest pricing', d: 'Itemized estimates and straight answers on cost. No games, no surprise change orders.' },
];

const homeFaqs = [
  { q: 'What areas do you serve?', a: 'We serve Knoxville and all of Knox County, plus Farragut, Maryville, Alcoa, Oak Ridge, Clinton, Sevierville, Seymour, Lenoir City and the surrounding East Tennessee communities.' },
  { q: 'Are you licensed and insured?', a: 'Yes — Paramount is fully licensed and insured, and we back our work with a workmanship warranty. We’ll gladly provide proof of insurance before we start.' },
  { q: 'How does the free consultation work?', a: 'Every project starts with a free phone consultation — we talk through what you want, your space and your budget before anyone drives out. Send a few photos and rough measurements and we can give you a realistic price range up front. When it’s a good fit, we schedule an on-site visit to take exact measurements and put your price in writing.' },
  { q: 'How soon can you start my project?', a: 'It depends on the season and our schedule, but we’ll give you a realistic timeline up front. Reach out early — spring and fall book up fast.' },
];
---

<BaseLayout
  title="Outdoor Living & Concrete Contractor in Knoxville, TN | Paramount"
  description="Outdoor living builder in Knoxville & East TN — covered patios, outdoor kitchens, backyard sport courts and full backyard builds, plus concrete driveways, patios, pavers and retaining walls engineered for our clay soil. Free phone consultation: (865) 237-9770."
  path={path}
>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-[var(--color-steel)]">
    <div class="absolute inset-0">
      <img
        src="/images/hero-backyard.jpg"
        alt="Backyard outdoor living space with a stamped-concrete pool deck built by Paramount Concrete & Hardscapes in West Knoxville, TN"
        class="h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/55 to-black/25"></div>
    </div>
    <div class="wrap relative grid gap-12 py-20 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:py-28">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-white/80">Knoxville · East Tennessee · Since 2018</p>
        <h1 class="mt-4 text-4xl font-black leading-[1.02] text-white sm:text-6xl">
          Backyards built for the way<br />
          <span class="text-[var(--color-flame)]">your family actually lives.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-white/90">
          Patios, covers, outdoor kitchens and sport courts — built on concrete and
          hardscape work engineered for East Tennessee’s clay soil and freeze-thaw winters.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact/" class="btn btn-primary text-base">Get a Free Phone Consultation</a>
          <a href={company.phoneHref} class="btn border-2 border-white/70 text-base text-white hover:bg-white hover:text-[var(--color-bone)]">Call {company.phone}</a>
        </div>
        <p class="mt-5 text-sm text-white/80">
          Locally owned since {company.yearFounded} · Licensed &amp; insured · Free phone consultations
        </p>
      </div>

      <div class="rounded-2xl border border-[var(--color-steel)] bg-[var(--color-graphite)] p-6 shadow-2xl">
        <h2 class="text-xl font-extrabold text-[var(--color-bone)]">Book a free phone consultation</h2>
        <p class="mb-4 mt-1 text-sm text-[var(--color-concrete-dim)]">Tell us about your project — we’ll call to talk it through before anything else.</p>
        <QuoteForm compact />
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- WHAT WE BUILD — three-tier model (ascending by price) -->
  <section class="wrap py-16">
    <div class="max-w-2xl">
      <p class="eyebrow">What we build</p>
      <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Three ways to build your backyard</h2>
      <p class="mt-4 text-[var(--color-concrete)]">From high-volume concrete flatwork to a full custom backyard, we build at three levels. Start wherever fits your project and your budget — and step up when you’re ready.</p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {
        tiers.map((t) => (
          <a href={t.href} class="group flex flex-col rounded-2xl border border-[var(--color-steel)] bg-[var(--color-graphite)] p-7 transition hover:-translate-y-1 hover:border-[var(--color-flame)]">
            <p class="text-sm font-bold uppercase tracking-wider text-[var(--color-flame)]">{t.range}</p>
            <h3 class="mt-2 text-2xl font-black group-hover:text-[var(--color-flame)]">{t.name}</h3>
            <p class="mt-3 text-[var(--color-concrete)]">{t.desc}</p>
            <ul class="mt-4 space-y-1.5 text-sm text-[var(--color-concrete-dim)]">
              {t.examples.map((e) => (
                <li class="flex gap-2"><span class="text-[var(--color-flame)]">•</span>{e}</li>
              ))}
            </ul>
            <span class="mt-6 font-bold text-[var(--color-flame)]">{t.cta} →</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- WHY US -->
  <section class="border-y border-[var(--color-steel)] bg-[var(--color-graphite)]">
    <div class="wrap py-16">
      <div class="max-w-2xl">
        <p class="eyebrow">Why Paramount</p>
        <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Why our work outlasts the other guys’</h2>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          whyUs.map((w) => (
            <div class="rounded-xl border border-[var(--color-steel)] bg-[var(--color-ink)] p-6">
              <p class="text-lg font-extrabold text-[var(--color-bone)]">{w.t}</p>
              <p class="mt-2 text-sm text-[var(--color-concrete-dim)]">{w.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROCESS — two tracks -->
  <section class="wrap py-16">
    <div class="max-w-2xl">
      <p class="eyebrow">How it works</p>
      <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Two ways to work, depending on the build</h2>
      <p class="mt-4 text-[var(--color-concrete)]">Straightforward concrete flatwork starts on the phone. Larger outdoor-living and custom builds start with a paid design step — because getting grade, drainage and layout right on paper first is what makes a big project come out right.</p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <!-- Track A: phone-first -->
      <div class="rounded-2xl border border-[var(--color-steel)] bg-[var(--color-graphite)] p-7">
        <p class="text-sm font-bold uppercase tracking-wider text-[var(--color-flame)]">Concrete & flatwork · phone-first</p>
        <ol class="mt-5 space-y-5">
          {flatworkSteps.map((s) => (
            <li class="flex gap-4">
              <span class="text-2xl font-black text-[var(--color-flame)]">{s.n}</span>
              <div>
                <p class="font-extrabold text-[var(--color-bone)]">{s.t}</p>
                <p class="mt-1 text-sm text-[var(--color-concrete-dim)]">{s.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- Track B: design-first -->
      <div class="rounded-2xl border-2 border-[var(--color-flame)] bg-[var(--color-graphite)] p-7">
        <p class="text-sm font-bold uppercase tracking-wider text-[var(--color-flame)]">Outdoor living & custom builds · design-first</p>
        <ol class="mt-5 space-y-5">
          {designSteps.map((s) => (
            <li class="flex gap-4">
              <span class="text-2xl font-black text-[var(--color-flame)]">{s.n}</span>
              <div>
                <p class="font-extrabold text-[var(--color-bone)]">{s.t}</p>
                <p class="mt-1 text-sm text-[var(--color-concrete-dim)]">{s.d}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="mt-5 rounded-lg bg-[var(--color-graphite-2)] px-3 py-2 text-center text-xs font-semibold text-[var(--color-bone)]">The design consultation fee is credited in full toward your project.</p>
      </div>
    </div>
  </section>

  <!-- RECENT WORK -->
  <section class="wrap py-16">
    <div class="mb-8 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow">Recent work</p>
        <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Built across East Tennessee</h2>
      </div>
      <a href="/our-work/" class="btn btn-ghost">See full portfolio →</a>
    </div>
    <Gallery limit={8} showFilters={false} />
  </section>

  <!-- SERVICE AREAS -->
  <section class="border-t border-[var(--color-steel)] bg-[var(--color-graphite)]">
    <div class="wrap py-16">
      <div class="max-w-2xl">
        <p class="eyebrow">Where we build</p>
        <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Serving Knoxville &amp; East Tennessee</h2>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        {
          serviceAreas.map((a) => (
            <a href={`/service-area/${a.slug}/`} class="rounded-full border border-[var(--color-steel)] bg-[var(--color-ink)] px-4 py-2 text-sm font-semibold text-[var(--color-concrete)] transition hover:border-[var(--color-flame)] hover:text-[var(--color-flame)]">
              {a.city}, TN
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <InstagramFeed />

  <Faq faqs={homeFaqs} />

  <CtaBand />
</BaseLayout>
