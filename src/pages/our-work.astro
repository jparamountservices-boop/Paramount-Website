---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import Gallery from '../components/Gallery.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import { featuredProjects } from '../data/featuredProjects';
import { breadcrumbSchema } from '../lib/schema';

const path = '/our-work/';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Our Work', path },
];
---

<BaseLayout
  title="Our Work | Concrete & Hardscape Portfolio | Knoxville TN | Paramount"
  description="Browse recent concrete, paver, patio, retaining wall and outdoor living projects by Paramount Concrete & Hardscapes across Knoxville and East Tennessee."
  path={path}
  schemas={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="wrap py-10">
    <p class="eyebrow">Portfolio</p>
    <h1 class="mt-3 text-4xl font-black sm:text-5xl">Our Work</h1>
    <p class="mt-4 max-w-2xl text-lg text-[var(--color-concrete)]">
      A look at recent driveways, patios, walls and outdoor living spaces we’ve built across East
      Tennessee. Filter by project type — and picture what we could build for you.
    </p>
  </section>

  {featuredProjects[0] && <FeaturedProject project={featuredProjects[0]} />}

  <section class="wrap pb-16">
    <h2 class="mb-6 text-2xl font-extrabold">More of our work</h2>
    <Gallery />
  </section>

  <InstagramFeed />

  <CtaBand />
</BaseLayout>
