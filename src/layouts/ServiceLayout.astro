---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TrustBar from '../components/TrustBar.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import QuoteForm from '../components/QuoteForm.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { company } from '../data/company';
import { getService, type Service } from '../data/services';
import { localTownsForService, type LocalService } from '../data/localServicePages';
import { captionFromFilename } from '../data/projectCategories';
import { breadcrumbSchema, serviceSchema, faqSchema } from '../lib/schema';

interface Props {
  service: Service;
}
const { service } = Astro.props;

const path = `/${service.path}/`;
const parent = service.parent ? getService(service.parent) : undefined;

const crumbs = [
  { name: 'Home', path: '/' },
  ...(parent ? [{ name: parent.navLabel.replace(' (overview)', ''), path: `/${parent.path}/` }] : []),
  { name: service.navLabel.replace(' (overview)', ''), path },
];

const related = service.related
  .map((p) => getService(p))
  .filter((s): s is Service => Boolean(s));

// Optional real project photos for this service (src/assets/projects/<folder>/).
const projectModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projects/**/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
let photos: { src: string; alt: string }[] = [];
if (service.photoFolder) {
  const entries = Object.entries(projectModules)
    .filter(([p]) => p.split('/').slice(-2)[0] === service.photoFolder)
    .sort(([a], [b]) => (a < b ? -1 : 1));
  for (const [p, mod] of entries) {
    const file = p.split('/').pop()!;
    const img = await getImage({ src: mod.default, width: 900, format: 'webp', quality: 78 });
    photos.push({ src: img.src, alt: `${captionFromFilename(file)} — Paramount Concrete & Hardscapes, Knoxville TN` });
  }
}

// On the Concrete/Pavers hubs, list the towns with dedicated local pages.
const localTowns =
  service.path === 'concrete' || service.path === 'pavers'
    ? localTownsForService(service.path as LocalService)
    : [];
const localLabel = service.path === 'pavers' ? 'Pavers' : 'Concrete';

// Match real reviews to this page by keywords in the service path.
const tagRules: [RegExp, string][] = [
  [/outdoor-living/, 'outdoor-living'], [/patio-covers/, 'pergola'], [/fire-pit/, 'fire-pit'],
  [/pool-deck/, 'pool-deck'], [/driveway/, 'driveway'], [/stamped/, 'stamped'],
  [/walkway|sidewalk/, 'walkway'], [/retaining/, 'retaining-wall'], [/^pavers/, 'pavers'],
  [/patio/, 'patio'], [/^hardscapes$/, 'fire-pit'],
];
const reviewTags = tagRules.filter(([re]) => re.test(service.path)).map(([, t]) => t);

const schemas = [
  breadcrumbSchema(crumbs),
  serviceSchema({
    name: service.h1,
    description: service.metaDescription,
    path,
    serviceType: service.schemaServiceType,
    areaServedList: service.schemaAreaServed,
  }),
  ...(service.faqs.length ? [faqSchema(service.faqs)] : []),
];
---

<BaseLayout
  title={service.title}
  description={service.metaDescription}
  path={path}
  schemas={schemas}
  noindex={service.noindex}
>
  <Breadcrumbs items={crumbs} />

  <!-- Hero -->
  <section class="wrap grid gap-10 pb-6 pt-4 lg:grid-cols-[1.15fr_1fr] lg:items-center">
    <div>
      <p class="eyebrow">Knoxville · East Tennessee</p>
      <h1 class="mt-3 text-4xl font-black sm:text-5xl">{service.h1}</h1>
      <p class="mt-5 max-w-xl text-lg text-[var(--color-concrete)]">{service.heroSubhead}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/contact/" class="btn btn-primary">Get a Free Phone Consultation</a>
        <a href={company.phoneHref} class="btn btn-ghost">Call {company.phone}</a>
      </div>
    </div>
    <div class="rounded-xl border border-[var(--color-steel)] bg-[var(--color-graphite)] p-6">
      <p class="mb-1 text-sm font-bold uppercase tracking-wider text-[var(--color-flame)]">Free Phone Consultation</p>
      <p class="mb-4 text-sm text-[var(--color-concrete-dim)]">Tell us about your project — we’ll get right back to you.</p>
      <QuoteForm compact />
    </div>
  </section>

  <TrustBar />

  <!-- Body copy -->
  <article class="wrap prose-dark py-14">
    <div class="mx-auto max-w-3xl">
      {service.intro.map((p) => <p>{p}</p>)}

      {service.sections.map((sec) => (
        <>
          <h2>{sec.h2}</h2>
          {sec.body?.map((p) => <p>{p}</p>)}
          {sec.bullets && (
            <ul>{sec.bullets.map((b) => <li>{b}</li>)}</ul>
          )}
          {sec.link && (
            <p><a href={sec.link.href} class="font-semibold text-[var(--color-flame-300)] underline">{sec.link.label} →</a></p>
          )}
        </>
      ))}

      {service.costTable && (
        <>
          <h2>{service.costTable.heading}</h2>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left text-sm">
              <thead>
                <tr>
                  {service.costTable.columns.map((c) => (
                    <th class="border-b border-[var(--color-steel)] py-2 pr-4 font-bold text-[var(--color-bone)]">{c}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {service.costTable.rows.map((r) => (
                  <tr>
                    {r.map((cell) => (
                      <td class="border-b border-[var(--color-steel)] py-2 pr-4 text-[var(--color-concrete)]">{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {service.costTable.note && <p class="mt-3 font-semibold text-[var(--color-bone)]">{service.costTable.note}</p>}
          {service.costTable.sourceLink && (
            <p class="text-sm"><a href={service.costTable.sourceLink.href} class="font-semibold text-[var(--color-flame-300)] underline">{service.costTable.sourceLink.label} →</a></p>
          )}
        </>
      )}

      {service.costNote && (
        <div class="my-8 rounded-lg border-l-4 border-[var(--color-flame)] bg-[var(--color-graphite)] p-5">
          <p class="m-0 text-sm font-bold uppercase tracking-wider text-[var(--color-flame)]">What it costs</p>
          <p class="m-0 mt-2">{service.costNote}</p>
        </div>
      )}

      {service.relatedPost && (
        <p class="my-6">
          <a href={service.relatedPost.path} class="font-semibold text-[var(--color-flame-300)] underline">
            {service.relatedPost.label} →
          </a>
        </p>
      )}
    </div>
  </article>

  <!-- Real project photos (only if we have them for this service) -->
  {photos.length > 0 && (
    <section class="wrap pb-14">
      <h2 class="mb-6 text-2xl font-extrabold">Recent {service.navLabel.replace(' (overview)', '').toLowerCase()} work</h2>
      <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
        {photos.map((ph) => (
          <figure class="overflow-hidden rounded-xl border border-[var(--color-steel)] bg-[var(--color-graphite-2)]">
            <img src={ph.src} alt={ph.alt} loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" />
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- Related services (internal links) -->
  {related.length > 0 && (
    <section class="wrap pb-14">
      <h2 class="mb-6 text-2xl font-extrabold">Related services</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((r) => (
          <a href={`/${r.path}/`} class="group rounded-lg border border-[var(--color-steel)] bg-[var(--color-graphite)] p-5 transition hover:border-[var(--color-flame)]">
            <p class="font-bold text-[var(--color-bone)] group-hover:text-[var(--color-flame)]">{r.navLabel.replace(' (overview)', '')}</p>
            <p class="mt-1 text-sm text-[var(--color-concrete-dim)]">{r.heroSubhead}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {localTowns.length > 0 && (
    <section class="wrap pb-14">
      <h2 class="mb-2 text-2xl font-extrabold">{localLabel} by town</h2>
      <p class="mb-6 text-[var(--color-concrete-dim)]">Local {localLabel.toLowerCase()} pages for the communities we serve most across East Tennessee.</p>
      <div class="flex flex-wrap gap-3 text-sm">
        {localTowns.map((t) => (
          <a href={`/${service.path}/${t.townSlug}/`} class="rounded-full border border-[var(--color-steel)] px-4 py-2 text-[var(--color-concrete)] transition hover:border-[var(--color-flame)] hover:text-[var(--color-flame)]">
            {localLabel} in {t.city}
          </a>
        ))}
      </div>
    </section>
  )}

  <ReviewStrip tags={reviewTags} featured={reviewTags.length === 0} />

  {service.faqs.length > 0 && <Faq faqs={service.faqs} />}

  <CtaBand />
</BaseLayout>
