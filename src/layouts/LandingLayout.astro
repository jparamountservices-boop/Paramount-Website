---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SEO from '../components/SEO.astro';
import ConversionTag from '../components/ConversionTag.astro';
import Logo from '../components/Logo.astro';
import TrustBar from '../components/TrustBar.astro';
import Faq from '../components/Faq.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { company } from '../data/company';
import { getService } from '../data/services';
import { reviews } from '../data/reviews';
import type { LandingPage } from '../data/landingPages';

interface Props {
  page: LandingPage;
}
const { page } = Astro.props;
const service = getService(page.servicePath)!;
const path = `/lp/${page.slug}/`;
const defaultService = service.navLabel.replace(' (overview)', '');

// Optional hero image, matched by filename.
let heroSrc = '';
if (page.heroPhotoMatch) {
  const modules = import.meta.glob<{ default: ImageMetadata }>(
    '../assets/projects/**/*.{jpg,jpeg,png,webp,avif}',
    { eager: true }
  );
  for (const [p, mod] of Object.entries(modules)) {
    if (p.toLowerCase().includes(page.heroPhotoMatch.toLowerCase())) {
      const img = await getImage({ src: mod.default, width: 1400, format: 'webp', quality: 80 });
      heroSrc = img.src;
      break;
    }
  }
}

// A concrete-relevant review quote.
const review =
  reviews.find((r) => /concrete|driveway|patio|stamped|sidewalk|slab/i.test(r.service || '')) || reviews[0];

// Up to 3 short proof sections from the source service.
const proof = service.sections.slice(0, 3);

const title = `${page.h1} | Paramount Concrete & Hardscapes`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <ConversionTag />
    <SEO title={title} description={service.metaDescription} path={path} noindex={true} />
  </head>
  <body>
    <!-- Minimal header: logo + call only (no nav) -->
    <header class="sticky top-0 z-50 border-b border-[var(--color-steel)] bg-[color-mix(in_srgb,var(--color-ink)_92%,transparent)] backdrop-blur">
      <div class="wrap flex items-center justify-between gap-4 py-3">
        <Logo />
        <a href={company.phoneHref} class="btn btn-primary text-sm">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11 11 0 0 0 3.5.56 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.2.2 2.4.56 3.5a1 1 0 0 1-.24 1l-2.2 2.3Z"/></svg>
          <span class="hidden sm:inline">Call </span>{company.phone}
        </a>
      </div>
    </header>

    <!-- Hero + form above the fold -->
    <section class="relative border-b border-[var(--color-steel)]">
      {heroSrc && (
        <div class="absolute inset-0">
          <img src={heroSrc} alt={`${defaultService} in Knoxville, TN by Paramount`} class="h-full w-full object-cover" />
          <div class="absolute inset-0 bg-[color-mix(in_srgb,var(--color-ink)_82%,transparent)]"></div>
        </div>
      )}
      <div class="wrap relative grid gap-8 py-10 lg:grid-cols-[1.05fr_1fr] lg:items-start">
        <div>
          <p class="eyebrow">Knoxville · East Tennessee</p>
          <h1 class="mt-3 text-3xl font-black sm:text-4xl lg:text-5xl">{page.h1}</h1>
          <p class="mt-5 max-w-xl text-lg text-[var(--color-concrete)]">{page.valueProp}</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#lead-form" class="btn btn-primary">Get My Free Quote</a>
            <a href={company.phoneHref} class="btn btn-ghost">Call {company.phone}</a>
          </div>
        </div>
        <div id="lead-form" class="scroll-mt-24 rounded-2xl border border-[var(--color-steel)] bg-[var(--color-graphite)] p-6 shadow-2xl">
          <p class="text-sm font-bold uppercase tracking-wider text-[var(--color-flame)]">Free Phone Consultation</p>
          <p class="mb-4 mt-1 text-sm text-[var(--color-concrete-dim)]">Tell us about your project — we’ll call to talk it through.</p>
          <QuoteForm defaultService={defaultService} />
        </div>
      </div>
    </section>

    <TrustBar />

    <!-- Proof / body copy -->
    <article class="wrap prose-dark py-14">
      <div class="mx-auto max-w-3xl">
        {service.intro.map((p) => <p>{p}</p>)}
        {proof.map((sec) => (
          <>
            <h2>{sec.h2}</h2>
            {sec.body?.map((p) => <p>{p}</p>)}
            {sec.bullets && <ul>{sec.bullets.map((b) => <li>{b}</li>)}</ul>}
          </>
        ))}
        {service.costNote && (
          <div class="my-8 rounded-lg border-l-4 border-[var(--color-flame)] bg-[var(--color-graphite)] p-5">
            <p class="m-0 text-sm font-bold uppercase tracking-wider text-[var(--color-flame)]">What it costs</p>
            <p class="m-0 mt-2">{service.costNote}</p>
          </div>
        )}
      </div>
    </article>

    <!-- Review quote -->
    {review && (
      <section class="border-y border-[var(--color-steel)] bg-[var(--color-graphite)]">
        <div class="wrap max-w-3xl py-12 text-center">
          <div class="text-[var(--color-flame)]">{'★'.repeat(review.rating)}</div>
          <blockquote class="mt-4 text-xl font-medium text-[var(--color-bone)]">“{review.text}”</blockquote>
          <p class="mt-4 text-sm text-[var(--color-concrete-dim)]">{review.author}{review.location ? ` · ${review.location}` : ''}</p>
        </div>
      </section>
    )}

    <!-- Repeated CTA -->
    <section class="wrap py-14 text-center">
      <h2 class="text-2xl font-black sm:text-3xl">Ready for a straight answer and a fair price?</h2>
      <p class="mx-auto mt-3 max-w-xl text-[var(--color-concrete)]">Every project starts with a free phone consultation — no surprise visits, no pressure.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="#lead-form" class="btn btn-primary">Get My Free Quote</a>
        <a href={company.phoneHref} class="btn btn-ghost">Call {company.phone}</a>
      </div>
    </section>

    {service.faqs.length > 0 && <Faq faqs={service.faqs} />}

    <!-- Final CTA -->
    <section class="border-t border-[var(--color-steel)] bg-[var(--color-flame)]">
      <div class="wrap flex flex-col items-center justify-between gap-4 py-8 text-center sm:flex-row sm:text-left">
        <p class="text-lg font-extrabold text-white">Let’s talk through your concrete project.</p>
        <div class="flex flex-wrap gap-3">
          <a href="#lead-form" class="btn bg-white text-[var(--color-ink)]">Get My Free Quote</a>
          <a href={company.phoneHref} class="btn btn-ghost border-white text-white">Call {company.phone}</a>
        </div>
      </div>
    </section>

    <!-- Minimal footer: NAP only, no nav links -->
    <footer class="border-t border-[var(--color-steel)] bg-[var(--color-graphite)]">
      <div class="wrap py-8 text-center text-sm text-[var(--color-concrete-dim)]">
        <p class="font-bold text-[var(--color-bone)]">{company.name}</p>
        <p class="mt-1">
          <a href={company.phoneHref} class="font-semibold text-[var(--color-flame-300)]">{company.phone}</a>
          &nbsp;·&nbsp; {company.address.city}, {company.address.state}
        </p>
        <p class="mt-1">Licensed &amp; insured · Serving Knoxville &amp; East Tennessee</p>
      </div>
    </footer>

    <!-- Sticky mobile call bar (call or jump to form) -->
    <div class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-2 border-t border-[var(--color-steel)] bg-[var(--color-graphite)] lg:hidden">
      <a href={company.phoneHref} class="flex items-center justify-center gap-2 py-3 text-sm font-bold text-[var(--color-bone)]">
        <svg viewBox="0 0 24 24" class="h-4 w-4 text-[var(--color-flame)]" fill="currentColor"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11 11 0 0 0 3.5.56 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.2.2 2.4.56 3.5a1 1 0 0 1-.24 1l-2.2 2.3Z"/></svg>
        Call Now
      </a>
      <a href="#lead-form" class="flex items-center justify-center gap-2 bg-[var(--color-flame)] py-3 text-sm font-bold text-white">Get My Quote</a>
    </div>
    <div class="h-14 lg:hidden" aria-hidden="true"></div>
  </body>
</html>
